          <mxGeometry x="340" y="330" width="64" height="64" as="geometry"/>
        </mxCell>

        <!-- NSG -->
        <mxCell id="nsg" value="NSG nsg-curie&lt;br&gt;libera 22 (SSH) e 8080 (API)" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/networking/Network_Security_Groups.svg;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1">
