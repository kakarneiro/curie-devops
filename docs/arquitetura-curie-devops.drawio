        <mxCell id="vm-label" value="&lt;b&gt;VM vm-curie&lt;/b&gt;&lt;br&gt;Ubuntu 22.04 LTS · Standard_B1s&lt;br&gt;criada via &lt;b&gt;Azure CLI&lt;/b&gt; (azure-deploy.sh)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
