        <mxCell id="cli" value="&lt;b&gt;Azure CLI&lt;/b&gt;&lt;br&gt;az group create · az vm create&lt;br&gt;az vm open-port · az group delete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7F3;strokeColor=#0078D4;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="180" height="80" as="geometry"/>
