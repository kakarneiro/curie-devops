        <!-- Edges -->
        <mxCell id="e-user-pip" value="HTTP :8080&lt;br&gt;Swagger UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#0F1F3D;fontSize=11;" edge="1" parent="1" source="user" target="pip">
