<mxfile host="app.diagrams.net" type="device">
  <diagram id="curie-devops" name="Arquitetura CURIE - DevOps">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Titulo -->
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px&quot;&gt;Projeto CURIE — Arquitetura simplificada (DevOps Tools &amp;amp; Cloud Computing)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6a7179&quot;&gt;Grupo CURIE · 2TDSPB · Challenge FIAP 2026 / CTMSP&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1000" height="50" as="geometry"/>
        </mxCell>

        <!-- Usuarios -->
        <mxCell id="user" value="Aluno / Professor&lt;br&gt;(navegador · app Flutter)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="50" height="90" as="geometry"/>
        </mxCell>

        <!-- Azure subscription / resource group -->
        <mxCell id="rg" value="Microsoft Azure · Resource Group &lt;b&gt;rg-curie&lt;/b&gt; (região brazilsouth)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F2F7FC;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=60;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="260" y="110" width="760" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="rg-icon" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/general/Resource_Groups.svg;" vertex="1" parent="1">
          <mxGeometry x="275" y="118" width="36" height="30" as="geometry"/>
        </mxCell>

        <!-- VNet -->
        <mxCell id="vnet" value="Virtual Network vnet-curie · subnet 10.0.0.0/24" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#5E9ED6;verticalAlign=top;align=left;spacingLeft=50;spacingTop=4;fontSize=12;fontColor=#5E9ED6;" vertex="1" parent="1">
          <mxGeometry x="300" y="170" width="680" height="470" as="geometry"/>
