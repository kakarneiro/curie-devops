        <!-- GitHub / Azure CLI -->
        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;repositório curie-api&lt;br&gt;Dockerfile · azure-deploy.sh&lt;br&gt;azure-cleanup.sh · README" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7F3;strokeColor=#24292E;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
